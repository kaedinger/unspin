#!/bin/bash
# rc.unspin - Unspin daemon service controller
# Usage: /etc/rc.d/rc.unspin {start|stop|restart|status}
#        /etc/rc.d/rc.unspin pause <name> [--ttl <time>]   # e.g. --ttl 15m
#        /etc/rc.d/rc.unspin unpause <name>
#        /etc/rc.d/rc.unspin toggle [name]   # name only needed when this pauses

DAEMON=/usr/local/sbin/unspind
PID_FILE=/var/run/unspind.pid
PAUSE_DIR=/var/run/unspind.pause.d
PAUSE_STATE=/var/run/unspind.pause-reasons   # written by unspind: Mover, rsync, signal
LOG_FILE=/var/log/unspin.log

CFG_FILE=/boot/config/plugins/unspin/unspin.cfg

log_info() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [INFO ] $1" >> "$LOG_FILE"
}

# Only with Log Level set to Debug in the settings, like the daemon's debug lines.
log_debug() {
    grep -qE '^LOG_LEVEL="?debug"?' "$CFG_FILE" 2>/dev/null || return 0
    echo "$(date '+%Y-%m-%d %H:%M:%S') [DEBUG] $1" >> "$LOG_FILE"
}

pause_count() {
    local n=0
    [ -d "$PAUSE_DIR" ] && n=$(find "$PAUSE_DIR" -maxdepth 1 -type f | wc -l)
    echo "$n"
}

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

unspin_start() {
    if is_running; then
        echo "unspind is already running (PID $(cat "$PID_FILE"))."
        return 0
    fi
    if [ ! -x "$DAEMON" ]; then
        echo "Error: $DAEMON not found or not executable."
        return 1
    fi
    rm -rf "$PAUSE_DIR" "$PAUSE_STATE"
    echo "Starting unspind..."
    "$DAEMON" > /dev/null 2>&1 &
    echo $! > "$PID_FILE"
    echo "unspind started (PID $(cat "$PID_FILE"))."
}

unspin_stop() {
    local was_running=0
    if is_running; then
        was_running=1
        echo "Stopping unspind (PID $(cat "$PID_FILE"))..."
        kill "$(cat "$PID_FILE")" 2>/dev/null
        local i
        for i in 1 2 3 4 5; do
            kill -0 "$(cat "$PID_FILE")" 2>/dev/null || break
            sleep 1
        done
    fi
    # Catch orphans not tracked by the pidfile (left over from a prior install?).
    if pgrep -fx "$DAEMON" >/dev/null 2>&1; then
        echo "Killing orphan unspind processes: $(pgrep -fx "$DAEMON" | tr '\n' ' ')"
        pkill -fx "$DAEMON"
        sleep 1
        pkill -9 -fx "$DAEMON" 2>/dev/null
        was_running=1
    fi
    rm -f "$PID_FILE" "$PAUSE_STATE"
    rm -rf "$PAUSE_DIR"
    [ "$was_running" -eq 1 ] && echo "unspind stopped." || echo "unspind is not running."
}

unspin_status() {
    if is_running; then
        echo "unspind is running (PID $(cat "$PID_FILE"))."
        local r
        while read -r r; do
            case "$r" in
                signal) echo "Paused by signal (SIGUSR1/SIGRTMIN) - SIGUSR2 resumes." ;;
                ?*)     echo "Paused while $r is running." ;;
            esac
        done < <(cat "$PAUSE_STATE" 2>/dev/null)
        local n
        n=$(pause_count)
        if [ "$n" -gt 0 ]; then
            echo "Paused ($n lock(s)):"
            local f ttl left now
            now=$(date +%s)
            for f in "$PAUSE_DIR"/*; do
                [ -f "$f" ] || continue
                ttl=$(cat "$f" 2>/dev/null)
                if [[ "$ttl" =~ ^[0-9]+$ ]] && [ "$ttl" -gt 0 ]; then
                    left=$(( ttl - (now - $(stat -c %Y "$f")) ))
                    [ "$left" -lt 0 ] && left=0
                    echo "  $(basename "$f") (expires in $(fmt_secs "$left") unless refreshed)"
                else
                    echo "  $(basename "$f")"
                fi
            done
        fi
        return 0
    else
        echo "unspind is not running."
        return 1
    fi
}

validate_name() {
    if [ -z "$1" ]; then
        echo "Error: a name is required (e.g. $0 $2 borgbackup)."
        return 1
    fi
    if ! echo "$1" | grep -qE '^[a-zA-Z0-9._-]+$'; then
        echo "Error: name must contain only letters, digits, dots, hyphens, and underscores."
        return 1
    fi
    return 0
}

# "90s", "15m", "2h", "1d" -> seconds; empty output = invalid.
parse_ttl() {
    [[ "$1" =~ ^([0-9]{1,6})([smhd])$ ]] || return
    local n=$(( 10#${BASH_REMATCH[1]} ))
    case "${BASH_REMATCH[2]}" in
        s) echo "$n" ;;
        m) echo $(( n * 60 )) ;;
        h) echo $(( n * 3600 )) ;;
        d) echo $(( n * 86400 )) ;;
    esac
}

fmt_secs() {
    local s=$1
    if   [ "$s" -ge 3600 ]; then echo "$(( s / 3600 ))h $(( s % 3600 / 60 ))m"
    elif [ "$s" -ge 60 ];   then echo "$(( s / 60 ))m $(( s % 60 ))s"
    else                         echo "${s}s"
    fi
}

# A lock with --ttl holds the TTL in seconds as file content and expires if its
# mtime (last pause call) is older than that; unspind removes it then. Calling
# pause again refreshes the lock, and the last call decides: without --ttl the
# lock doesn't expire.
unspin_pause() {
    local name="$1" ttl=""
    validate_name "$name" "pause" || return 1
    if [ -n "$2" ]; then
        if [ "$2" != "--ttl" ] || [ -z "$3" ] || [ -n "$4" ]; then
            echo "Usage: $0 pause <name> [--ttl <time>]   (time e.g. 90s, 15m, 2h, 1d)"
            return 1
        fi
        ttl=$(parse_ttl "$3")
        if [ -z "$ttl" ] || [ "$ttl" -le 0 ]; then
            echo "Error: invalid --ttl '$3' - use a number with s, m, h or d (e.g. 15m)."
            return 1
        fi
    fi
    if ! is_running; then
        echo "unspind is not running."
        return 1
    fi
    mkdir -p "$PAUSE_DIR"
    local existed=0 n info=""
    [ -f "$PAUSE_DIR/$name" ] && existed=1
    printf '%s' "$ttl" > "$PAUSE_DIR/$name"
    n=$(pause_count)
    [ -n "$ttl" ] && info=", expires $(fmt_secs "$ttl") after the last refresh"
    if [ "$existed" -eq 1 ]; then
        # Debug only: a job refreshing its lock every few minutes would fill the log.
        log_debug "Pause lock refreshed - $name ($n lock(s) held$info)"
        echo "Pause lock '$name' refreshed ($n lock(s) held$info)."
    else
        log_info "Pause lock added - $name ($n lock(s) held$info)"
        echo "unspind paused by '$name' ($n lock(s) held$info)."
    fi
}

unspin_unpause() {
    validate_name "$1" "unpause" || return 1
    if ! is_running; then
        echo "unspind is not running."
        return 1
    fi
    if [ ! -f "$PAUSE_DIR/$1" ]; then
        echo "No pause lock '$1' found."
        return 1
    fi
    rm -f "$PAUSE_DIR/$1"
    local n
    n=$(pause_count)
    log_info "Pause lock released - $1 ($n lock(s) remaining)"
    if [ "$n" -eq 0 ]; then
        echo "unspind unpaused (last lock '$1' released)."
    else
        echo "Lock '$1' released ($n lock(s) remaining)."
    fi
}

unspin_toggle() {
    if ! is_running; then
        echo "unspind is not running."
        return 1
    fi
    if [ "$(pause_count)" -gt 0 ]; then
        log_info "Toggle - clearing all pause locks"
        rm -rf "$PAUSE_DIR"
        echo "unspind unpaused (all locks cleared)."
    else
        validate_name "$1" "toggle" || return 1
        mkdir -p "$PAUSE_DIR"
        touch "$PAUSE_DIR/$1"
        log_info "Toggle - pause lock added: $1"
        echo "unspind paused by '$1'."
    fi
}

case "$1" in
    start)   unspin_start ;;
    stop)    unspin_stop ;;
    restart) unspin_stop; sleep 1; unspin_start ;;
    status)  unspin_status ;;
    pause)   unspin_pause "$2" "$3" "$4" "$5" ;;
    unpause) unspin_unpause "$2" ;;
    toggle)  unspin_toggle "$2" ;;
    *)       echo "Usage: $0 {start|stop|restart|status|toggle [name]}"
             echo "       $0 pause <name> [--ttl <time>]   (time e.g. 90s, 15m, 2h, 1d)"
             echo "       $0 unpause <name>"
             exit 1 ;;
esac
